# ── PostgreSQL Database ──
# Every value below is a PLACEHOLDER, not a working credential: copying this file
# to .env without editing it produces a startup failure by design (see
# validate_production_settings in backend/core/config.py). No real credential
# belongs in this file, in scripts, or in git history.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kisanmitra
DB_USER=kisanmitra_user
# Required. There is deliberately no built-in default in the code.
DB_PASSWORD=your_secure_password_here
# Prints every SQL statement with its bound parameters. Keep this false: the
# parameters include farmer declarations and any credential that appears inside
# a stored error message. Development used to force it on; it is opt-in now.
DB_SQL_ECHO=false

# ── WhatsApp Cloud API (Guardrail 4) ──
WHATSAPP_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_VERIFY_TOKEN=change_me_random_value_min_16_chars
WHATSAPP_APP_SECRET=your_app_secret

# ── Gemini API (Phase 3 AI Layer) ──
GEMINI_API_KEY=your_gemini_production_key

# ── Application Settings ──
APP_ENV=production
APP_PORT=8000
# JWT signing key + the shared bot<->backend internal secret. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimum 32 characters in production. Values that appeared in this repository's
# history are rejected at startup, so a key copied from an old branch will not work.
SECRET_KEY=generate_a_random_secure_key_here

# Telegram Bot ──
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here



# Redis for FSM state persistence (bot survives restarts)
REDIS_URL=redis://localhost:6379/1

# URL the Telegram bot uses to call the FastAPI backend
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT=12.0

# Production webhook (leave blank to use polling in development)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=


# Comma-separated trusted frontend origins; never use * in production
CORS_ORIGINS=https://your-frontend-domain.example

# Max age (days) of a mandi record allowed for a price forecast; older data is
# reported as stale instead of being presented as today's price.
PRICE_MAX_AGE_DAYS=3

# ── AGMARKNET refresh ──────────────────────────────────────
# Required for the scheduled refresh and the manual /internal/data/refresh
# endpoint. Get one at https://data.gov.in (never commit it).
DATA_GOV_API_KEY=your-data-gov-in-api-key

# Run the in-process refresh scheduler (set false if using cron/systemd timers
# with scripts/refresh_prices.py instead).
REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=6

# Days of history re-requested per run. Deliberately overlaps so late uploads
# and mandi corrections are picked up; duplicates are ignored on write.
REFRESH_LOOKBACK_DAYS=10
REFRESH_STATE=Karnataka
