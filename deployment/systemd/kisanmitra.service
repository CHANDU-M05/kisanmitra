[Unit]
Description=KisanMitra FastAPI Server
After=network.target postgresql.service

[Service]
User=kisanmitra
Group=kisanmitra
WorkingDirectory=/home/kisanmitra/kisanmitra
Environment="PATH=/home/kisanmitra/kisanmitra/venv/bin"
EnvironmentFile=/home/kisanmitra/kisanmitra/.env
ExecStart=/home/kisanmitra/kisanmitra/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
