# KisanMitra production environment template.
# Copy to /opt/kisanmitra/.env.production on the server.
#   chmod 600 /opt/kisanmitra/.env.production
#
# NEVER commit this file. The real file must never appear in git history.
# Variable names MUST match the backend Settings class (backend/core/config.py).
# Verify with: grep -E "^\s+\w+:" backend/core/config.py
#
# Generate secrets:
#   openssl rand -hex 48    → 96-character hex string (use for SECRET_KEY)
#   openssl rand -hex 24    → 48-character hex string (use for passwords)

# ── Edge / Caddy routing ──────────────────────────────────────────────────────
# The domain Caddy will obtain a TLS certificate for (must resolve to this server)
DOMAIN=kisanmitra.example.com
ACME_EMAIL=admin@example.com
API_HEALTH_PATH=/health

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8000
# Minimum 32 characters. Generate: openssl rand -hex 48
SECRET_KEY=replace-with-openssl-rand-hex-48

# Comma-separated trusted frontend origins (no wildcard in production)
# Must match the value of DOMAIN above. Checked by validate_production_settings().
CORS_ORIGINS=https://kisanmitra.example.com

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────
# Host/port are the docker-compose service names; do not change these.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kisanmitra
DB_USER=kisanmitra
# Generate: openssl rand -hex 24
DB_PASSWORD=replace-with-openssl-rand-hex-24
DB_SQL_ECHO=false
# Per-worker connection pool. Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) x API_WORKERS x 2 replicas
# below postgres max_connections (200). Default 10 + 20 with 2 workers x 2 replicas = 120.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
REDIS_PASSWORD=replace-with-openssl-rand-hex-24
# REDIS_URL is consumed by the Telegram bot and any service that calls redis directly.
# The password here must match REDIS_PASSWORD above.
REDIS_URL=redis://:replace-with-openssl-rand-hex-24@redis:6379/0

# ── Integrations — rotate any value that was ever committed to git ─────────────
GEMINI_API_KEY=
DATA_GOV_API_KEY=
TELEGRAM_BOT_TOKEN=
# Telegram webhook (leave blank to use polling mode)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
BACKEND_URL=http://api-a:8000

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── n8n automation ────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-24

# ── AGMARKNET data refresh ────────────────────────────────────────────────────
REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=6
REFRESH_LOOKBACK_DAYS=10
REFRESH_STATE=Karnataka

# ── Capacity tuning ─────────────────────────────────────────────────────────
# Sized for the Oracle Always Free Ampere A1 shape as it stands in 2026-10:
# 2 OCPU / 12 GB RAM (Oracle halved the former 4 OCPU / 24 GB entitlement in
# July 2026). Budget: 2 API replicas x 3g + postgres + redis + n8n < 12 GB.
API_WORKERS=2
API_MEM_LIMIT=3g
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
REDIS_MAXMEMORY=256mb
PRICE_MAX_AGE_DAYS=3

# ── Optional offsite backup (requires rclone configured for the deploy user) ──
# RCLONE_REMOTE=remote:kisanmitra-backups
