# KisanMitra — Render + Neon + Cloudflare Pages environment template.
#
# The RENDER SERVICE needs no env file: every variable below is set through
# the render.yaml blueprint (non-secret values) and the Render dashboard
# (sync:false secrets you fill at creation time). This file exists so you can
# assemble values locally FIRST (never in the repo) before pasting each secret
# into the dashboard once, and for running the backend against Neon locally.
#
# NEVER commit real values. Assemble in a file outside the repo, e.g.
#   mktemp -d  →  cp this file there  →  fill  →  paste  →  shred -u the copy
#
# Variable names MUST match backend/core/config.py (Settings). Frontend
# variables (VITE_API_URL) are Cloudflare Pages BUILD-TIME variables, set in
# the Pages dashboard — they never reach this file.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
# Render injects PORT at runtime; the image binds ${PORT:-8000}. Do NOT set
# PORT in render.yaml or the dashboard — it would override Render's value.
# Locally (outside Render) the app defaults to 8000.
# Minimum 32 characters. Generate: openssl rand -hex 48
# Must be a FRESH value — known-leaked digests are rejected at startup.
SECRET_KEY=replace-with-openssl-rand-hex-48

# Exact Cloudflare Pages origin(s), comma-separated, no wildcard and no
# trailing slash. Production validation rejects '*'.
CORS_ORIGINS=https://your-project.pages.dev

# ── Neon PostgreSQL (direct — NOT the -pooler — endpoint) ─────────────────────
# Pooled (PgBouncer transaction) mode breaks the session-level advisory lock
# used by the AGMARKNET refresh; use the direct endpoint instead.
DB_HOST=ep-xxxxx-direct.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neon_role
DB_PASSWORD=paste-rotated-neon-password
# Neon requires TLS; psycopg3 maps this to the libpq sslmode connect kwarg.
DB_SSLMODE=require
# Small pool + aggressive recycle: Neon sleeps after 5 min idle, so a pooled
# connection can die between requests (pool_pre_ping + 300 s recycle rebuild
# it) and wake-up connects need a bounded retry.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
DB_CONNECT_RETRIES=3

# ── Models (57.2 MB total — downloaded at boot, never in git or the image) ────
# Render filesystem is ephemeral; everything writable lives under /tmp.
MODEL_DIR=/tmp/kisanmitra/models
KISANMITRA_LOCK_DIR=/tmp/kisanmitra/locks
KISANMITRA_LOG_DIR=/tmp/kisanmitra/logs
# HTTPS URL of the tar.gz holding price_model.pkl + encoders.pkl +
# model_metadata.json (see docs/RENDER_NEON_CLOUDFLARE_DEPLOYMENT.md §2).
MODEL_URL=https://private-object-url/kisanmitra-models.tar.gz
# sha256sum of that tarball. The service REFUSES to un-pickle an archive whose
# hash does not match — pickle loading executes arbitrary code, so this is not
# optional. Leave MODEL_URL empty only if models are bind-mounted some other way.
MODEL_SHA256=replace-with-sha256sum-output

# ── AGMARKNET in-process refresh (replaces n8n; catches up on wake) ───────────
REFRESH_ENABLED=true
REFRESH_INTERVAL_HOURS=6
REFRESH_LOOKBACK_DAYS=10
REFRESH_STATE=Karnataka
PRICE_MAX_AGE_DAYS=3

# ── Messaging / integration secrets (leave empty until that channel is used) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Telegram bot CANNOT run on Render free (no background workers). These matter
# only for the bot process running elsewhere/locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
DATA_GOV_API_KEY=

# ── Frontend (Cloudflare Pages BUILD-TIME variable, set in Pages dashboard) ──
# VITE_API_URL=https://your-service.onrender.com
# Overrides the committed frontend/.env.production (/api, Oracle-only) because
# Vite honors process env over .env files. Rebuild the Pages project after
# changing it — it is baked into the bundle, not read at runtime.
